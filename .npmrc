# node-linker=hoisted：规避本机 pnpm 符号链接限制
# （《三端规划与大方向.md》实测记录：无开发者模式时 pnpm 创建 symlink 会失败，
#   node-linker=hoisted 让 pnpm 用扁平复制的 node_modules，不创建符号链接）
node-linker=hoisted

# 插件的 peer 依赖由我们自己控制，不让 pnpm 因为版本范围偶发失败而中断安装
strict-peer-dependencies=false

# 首次安装时不自动执行依赖的构建脚本（明确列出需要的，避免隐式行为）
# 需要时用 `pnpm approve-builds` 显式批准
